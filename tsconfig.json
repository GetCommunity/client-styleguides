{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.lib.json",
  "include": ["./src/**/*", "eslint.config.mjs", "vite.config.ts", "prettier.config.js", "tsconfig.lib.json", "tsconfig.base.json"],
  "compilerOptions": {
    "skipLibCheck": true,
    "sourceMap": false
  },
  "exclude": ["dist", "node_modules", "dev", "tailwind.config.ts"]
}
{
  "name": "@getcommunity/client-styleguides",
  "description": "A collection of reusable styles for GetCommunity client projects.",
  "version": "0.0.46",
  "author": "@GetCommunity <ryan@getcommunity.com> (https://github.com/GetCommunity)",
  "contributors": [
    "Joey Grable <joey@getcommunity.com> (https://joeygrable.com)"
  ],
  "dependencies": {
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "solid-js": "^1.9.15",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "exports": {
    "./*": {
      "import": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "license": "ISC",
  "main": "./dist/getcommunity.cjs",
  "module": "./dist/getcommunity.js",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "https://github.com/GetCommunity/client-styleguides"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf .turbo node_modules dist",
    "dev:preview": "vite serve dev",
    "dev:watch": "tsdown --watch",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "source": "./src/index.ts",
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts",
        "./dist/index.d.ts"
      ]
    }
  }
}
